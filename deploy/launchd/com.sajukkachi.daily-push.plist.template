<?xml version="1.0" encoding="UTF-8"?>
<!--
  매일 07:00 아침 알림 발송 (ROADMAP R4). 설치 방법은 docs/DEPLOY_PUSH.md 참고.
  __PLACEHOLDER__ 를 실제 값으로 바꾼 뒤 ~/Library/LaunchAgents/ 로 복사하고 launchctl load.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sajukkachi.daily-push</string>

  <key>ProgramArguments</key>
  <array>
    <string>__UV_PATH__</string>
    <string>run</string>
    <string>python</string>
    <string>scripts/send_daily_push.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>KKACHI_VAPID_PUBLIC_KEY</key>
    <string>__VAPID_PUBLIC_KEY__</string>
    <key>KKACHI_VAPID_PRIVATE_KEY</key>
    <string>__VAPID_PRIVATE_KEY__</string>
    <key>KKACHI_VAPID_SUBJECT</key>
    <string>mailto:__EMAIL__</string>
    <key>KKACHI_DB_URL</key>
    <string>__DB_URL__</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/daily-push.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/daily-push.err.log</string>
</dict>
</plist>
